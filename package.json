{
	"name": "react-three-game",
	"version": "0.0.116",
	"description": "Serializable prefab documents for React Three Fiber scenes and games",
	"types": "./dist/index.d.ts",
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./core": {
			"types": "./dist/core/index.d.ts",
			"import": "./dist/core/index.js",
			"default": "./dist/core/index.js"
		},
		"./viewer": {
			"types": "./dist/viewer/index.d.ts",
			"import": "./dist/viewer/index.js",
			"default": "./dist/viewer/index.js"
		},
		"./editor": {
			"types": "./dist/editor/index.d.ts",
			"import": "./dist/editor/index.js",
			"default": "./dist/editor/index.js"
		},
		"./plugins": {
			"types": "./dist/plugins/index.d.ts",
			"import": "./dist/plugins/index.js",
			"default": "./dist/plugins/index.js"
		},
		"./plugins/*": {
			"types": "./dist/plugins/*/index.d.ts",
			"import": "./dist/plugins/*/index.js",
			"default": "./dist/plugins/*/index.js"
		},
		"./package.json": "./package.json",
		"./browser": {
			"types": "./dist/browser/index.d.ts",
			"import": "./dist/browser/index.js",
			"default": "./dist/browser/index.js"
		},
		"./headless": {
			"types": "./dist/headless/index.d.ts",
			"import": "./dist/headless/index.js",
			"default": "./dist/headless/index.js"
		},
		"./node": {
			"types": "./dist/node/index.d.ts",
			"import": "./dist/node/index.js",
			"default": "./dist/node/index.js"
		}
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"clean": "rm -rf dist",
		"watch": "npm run clean && tsc --watch",
		"dev": "npm run dev --workspace docs",
		"build": "npm run clean && tsc",
		"prepack": "npm run build",
		"release": "npm publish --access public",
		"test": "npm run test:lib && npm run test:docs",
		"test:lib": "node --import ./tests/support/register.mjs --test tests/*/*.test.mjs",
		"test:docs": "npm test --workspace docs",
		"test:package": "npm run build && node scripts/check-package.mjs"
	},
	"keywords": [],
	"author": "prnth",
	"license": "VPL",
	"type": "module",
	"engines": {
		"node": ">=22"
	},
	"workspaces": [
		"docs"
	],
	"peerDependencies": {
		"@react-three/drei": ">=10.0.0",
		"@react-three/fiber": ">=9.0.0",
		"react": ">=19.0.0",
		"react-dom": ">=19.0.0",
		"three": ">=0.182.0",
		"three-text": ">=0.4.4",
		"crashcat": ">=0.0.4"
	},
	"peerDependenciesMeta": {
		"crashcat": {
			"optional": true
		}
	},
	"devDependencies": {
		"@react-three/drei": ">=10.7.7",
		"@react-three/fiber": ">=9.8.0",
		"@types/react": ">=19.2.17",
		"@types/react-dom": ">=19.2.3",
		"@types/three": ">=0.184.1",
		"concurrently": ">=10.0.3",
		"crashcat": ">=0.0.4",
		"react": ">=19.3.0",
		"react-dom": ">=19.3.0",
		"three": ">=0.186.1",
		"typescript": ">=6.0.3",
		"vite": ">=8.0.16",
		"@types/node": "^20.19.26"
	},
	"dependencies": {
		"zustand": ">=5.0.14",
		"suspend-react": "^0.1.3"
	},
	"bin": {
		"rtg": "./dist/cli.js"
	}
}
